# =========================================================================
# Cricbuzz LiveStats Environment Configuration
# =========================================================================

# Port for production HTTP server (defaults to 3000)
PORT=3000

# Google Gemini API key for server-side speech transcription (optional)
# When provided, enables voice query transcription via /api/transcribe
GEMINI_API_KEY=

# Cricbuzz RapidAPI key for real-time live match feed (optional)
# When omitted, the application uses realistic match streams and local state
VITE_CRICBUZZ_API_KEY=
